{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@ndieu/kyc-core": ["packages/core/src"],
      "@ndieu/kyc-browser": ["packages/browser/src"],
      "@ndieu/kyc-node": ["packages/node/src"]
    }
  }
}
